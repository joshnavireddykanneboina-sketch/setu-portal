# ==============================================================================
# SETU - Jharkhand Societal Innovation Collaboration Portal
# Environment Variable Configuration Template
# Smart India Hackathon 2026 • Problem Statement ID 26043
# ==============================================================================
# Copy this file to .env and customize with your local/deployment settings:
#   cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Large Language Model (LLM) Integration
# Providers supported: 'gemini' | 'openai' | 'anthropic' | 'local'
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your_gemini_api_key_here

# Machine Learning Subsystem Mode
# Options:
#   'python'   - Calls Python Scikit-Learn TF-IDF classifier via subprocess
#   'fallback' - Uses lightweight heuristic pattern matching when Python is unavailable
ML_MODE=python

# Authentication & Cryptographic Security
# Replace with a cryptographically secure random string in production
JWT_SECRET=your_super_secret_jwt_key_setu_2026_change_in_production
SESSION_SECRET=your_super_secret_session_key_setu_2026

# Database File Configuration
# Path relative to backend or absolute path to database JSON file
SETU_DB_FILE=database/data/setu_db.json
