# ==========================================
# SETU - Git Ignore Rules
# Jharkhand Societal Innovation Collaboration Portal
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production Build & Bundler Caches
dist/
build/
.vite/
node_modules/.vite/

# Environment Variables & Secrets (CRITICAL SECURITY)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs & Diagnostic Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# Python & Machine Learning Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
.pytest_cache/
.coverage
htmlcov/

# Local Temporary Files & Archives
*.zip
*.tar.gz
*.rar
*.bak
*.tmp

# IDE & Editor Specific Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# Android / Capacitor
# ==========================================

# Android build outputs
android/app/build/
android/build/
android/.gradle/
android/*.keystore
android/release/

# Android local SDK config (machine-specific)
android/local.properties

# Capacitor-generated web assets copied into Android project
# (regenerated by `npm run android:build`)
android/app/src/main/assets/public/

# Android release signing env
.env.android
.env.android.local

# Gradle wrapper cache
.gradle/
